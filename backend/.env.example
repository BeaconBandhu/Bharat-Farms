# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored - never commit real keys. Mirror these in the Render
# dashboard (Environment) for the deployed service + cron job.
# ---------------------------------------------------------------------------

# --- OpenAI (vision, speech-to-text, text-to-speech, chat) ---
# Create a fresh key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- data.gov.in / Agmarknet mandi prices ---
# Optional. If left blank the app uses data.gov.in's public *sample* key, which
# is heavily rate-limited. Register your own (free) at https://data.gov.in ->
# profile -> "Generate API key". Resource: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=

# --- OpenWeather (current weather + forecast) ---
# Free tier at https://openweathermap.org/api  (new keys take ~1-2 h to activate)
OPENWEATHER_API_KEY=

# --- Agromonitoring (per-polygon NDVI stats, soil, accumulated rain/temp) ---
# Needs its OWN free key from https://agromonitoring.com/  (an OpenWeather key is
# NOT accepted). Leave blank to disable; the plot report degrades gracefully.
AGRO_API_KEY=

# --- Nominatim reverse geocoding (OpenStreetMap, no key) ---
# Their usage policy requires a real identifying UA string.
NOMINATIM_USER_AGENT=BharatFarms/1.0 (you@example.com)

# --- Infra ---
DATABASE_URL=sqlite:///./bharatfarms.db
CORS_ALLOW_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=30
