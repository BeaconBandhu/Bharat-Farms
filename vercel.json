{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bharat-farms": {
      "root": "backend",
      "entrypoint": "vercel_app:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "type": "service", "service": "bharat-farms" }
    }
  ],
  "crons": [
    { "path": "/api/admin/refresh", "schedule": "0 1 * * *" }
  ]
}
